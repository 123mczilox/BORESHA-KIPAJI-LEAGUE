# Local development works without a .env file:
# DEBUG defaults to True, SECRET_KEY gets a development-only value, and
# SQLite is used unless DB_HOST is set.

# Set a private value for SECRET_KEY if desired.
# SECRET_KEY=replace-with-a-private-random-value

# Configure all PostgreSQL values to use PostgreSQL instead of local SQLite.
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=prefer

# For production, set DEBUG=False and provide a secure SECRET_KEY and
# PostgreSQL connection values. Do not use the development fallback.